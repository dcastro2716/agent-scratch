.env
.venv/
__pycache__/
.pytest_cache/
# data/ es de trabajo: se versionan sus carpetas vacías, nunca su contenido
data/**
!data/*/
!data/*/.gitkeep
# evals/golden: el golden set base llega en evals.zip (plataforma); se versiona solo el caso de cada participante
evals/golden/*.jsonl
!evals/golden/*.AIE_*.jsonl